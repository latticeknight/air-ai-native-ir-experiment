{
  "openapi": "3.1.1",
  "info": {
    "title": "Benchmark 001 POST users",
    "version": "1.0.0"
  },
  "paths": {
    "/users": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email"],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "email": {
                    "type": "string",
                    "minLength": 5,
                    "pattern": "^[^\\s@]+@[^\\s@.]+\\.[^\\s@]+$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "409": {
            "description": "Duplicate email"
          },
          "500": {
            "description": "Storage unavailable"
          }
        }
      }
    }
  }
}
