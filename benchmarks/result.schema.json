{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIR comparative benchmark trial",
  "type": "object",
  "required": [
    "schema_version",
    "target",
    "benchmark",
    "trial_id",
    "generated_tokens",
    "repair_tokens",
    "model_calls",
    "compile_success",
    "runtime_success",
    "tests_passed",
    "tests_total",
    "repair_iterations",
    "direct_dependencies",
    "transitive_dependencies",
    "dependency_graph_depth",
    "capability_violations",
    "artifact_bytes",
    "source_bytes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "target": { "enum": ["air", "rust-wasm", "typescript-node"] },
    "benchmark": { "type": "string", "minLength": 1 },
    "trial_id": { "type": "string", "minLength": 1 },
    "generated_tokens": { "type": "integer", "minimum": 0 },
    "repair_tokens": { "type": "integer", "minimum": 0 },
    "model_calls": { "type": "integer", "minimum": 1 },
    "compile_success": { "type": "boolean" },
    "runtime_success": { "type": "boolean" },
    "tests_passed": { "type": "integer", "minimum": 0 },
    "tests_total": { "type": "integer", "minimum": 0 },
    "repair_iterations": { "type": "integer", "minimum": 0 },
    "direct_dependencies": { "type": "integer", "minimum": 0 },
    "transitive_dependencies": { "type": "integer", "minimum": 0 },
    "dependency_graph_depth": { "type": "integer", "minimum": 0 },
    "capability_violations": { "type": "integer", "minimum": 0 },
    "artifact_bytes": { "type": "integer", "minimum": 0 },
    "source_bytes": { "type": "integer", "minimum": 0 },
    "compile_milliseconds": { "type": "number", "minimum": 0 },
    "runtime_test_milliseconds": { "type": "number", "minimum": 0 },
    "failure": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}

