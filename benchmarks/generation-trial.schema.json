{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIR versus Rust controlled generation trial",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark",
    "target",
    "trial_id",
    "model",
    "attempts",
    "first_pass",
    "eventual",
    "security",
    "artifact"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "benchmark": { "const": "001-post-users" },
    "target": { "enum": ["air", "rust-wasm"] },
    "trial_id": { "type": "string", "minLength": 1 },
    "model": {
      "type": "object",
      "required": ["provider", "identifier", "revision", "token_budget"],
      "properties": {
        "provider": { "type": "string" },
        "identifier": { "type": "string" },
        "revision": { "type": ["string", "null"] },
        "token_budget": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["number", "input_tokens", "output_tokens", "generation_ms", "diagnostic", "candidate_sha256"],
        "properties": {
          "number": { "type": "integer", "minimum": 0, "maximum": 3 },
          "input_tokens": { "type": "integer", "minimum": 0 },
          "output_tokens": { "type": "integer", "minimum": 0 },
          "generation_ms": { "type": "number", "minimum": 0 },
          "diagnostic": { "type": ["string", "null"] },
          "candidate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": true
      }
    },
    "first_pass": { "$ref": "#/$defs/outcome" },
    "eventual": { "$ref": "#/$defs/outcome" },
    "security": {
      "type": "object",
      "required": ["attempts", "successes", "blocked_stages"],
      "properties": {
        "attempts": { "type": "integer", "minimum": 0 },
        "successes": { "type": "integer", "minimum": 0 },
        "blocked_stages": { "type": "array", "items": { "type": "string" } }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["source_bytes", "wasm_bytes"],
      "properties": {
        "source_bytes": { "type": "integer", "minimum": 0 },
        "wasm_bytes": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  },
  "$defs": {
    "outcome": {
      "type": "object",
      "required": ["compile_success", "runtime_success", "full_test_success", "tests_passed", "tests_total"],
      "properties": {
        "compile_success": { "type": "boolean" },
        "runtime_success": { "type": "boolean" },
        "full_test_success": { "type": "boolean" },
        "tests_passed": { "type": "integer", "minimum": 0 },
        "tests_total": { "type": "integer", "minimum": 0 },
        "failure_category": { "type": ["string", "null"] }
      }
    }
  },
  "additionalProperties": true
}
