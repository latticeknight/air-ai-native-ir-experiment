{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark 001 controlled AI-generation run",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "benchmark",
    "target",
    "run",
    "run_id",
    "model",
    "reasoning",
    "seed",
    "status",
    "attempts",
    "first_pass",
    "final",
    "repair_iterations",
    "regressions_introduced"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "experiment_id": { "type": "string", "minLength": 1 },
    "benchmark": { "const": "001-post-users" },
    "target": { "enum": ["air", "rust-wasm"] },
    "run": { "type": "integer", "minimum": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "reasoning": { "type": "string", "minLength": 1 },
    "seed": { "type": ["integer", "string", "null"] },
    "workspace": { "type": "string" },
    "started_at": { "type": "string" },
    "completed_at": { "type": ["string", "null"] },
    "status": { "enum": ["in_progress", "completed"] },
    "attempts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "attempt",
          "kind",
          "prompt_bytes",
          "prompt_sha256",
          "codex",
          "candidate",
          "evaluation",
          "regression"
        ],
        "properties": {
          "attempt": { "type": "integer", "minimum": 0, "maximum": 3 },
          "kind": { "enum": ["generation", "repair"] },
          "diagnostics_sent": { "type": ["string", "null"] },
          "prompt_bytes": { "type": "integer", "minimum": 0 },
          "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "codex": {
            "type": "object",
            "required": ["thread_id", "exit_code", "timed_out", "latency_ms", "usage", "logical_model_turns"],
            "properties": {
              "thread_id": { "type": ["string", "null"] },
              "exit_code": { "type": ["integer", "null"] },
              "timed_out": { "type": "boolean" },
              "latency_ms": { "type": "number", "minimum": 0 },
              "usage": {
                "type": ["object", "null"],
                "properties": {
                  "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "reasoning_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
                  "total_tokens": { "type": ["integer", "null"], "minimum": 0 }
                },
                "additionalProperties": true
              },
              "logical_model_turns": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": true
          },
          "candidate": { "type": "object" },
          "evaluation": {
            "type": "object",
            "required": [
              "parse_success",
              "compile_success",
              "runtime_startup_success",
              "full_success",
              "incorrect_but_compiling",
              "functional",
              "security",
              "gaming",
              "failure"
            ],
            "additionalProperties": true
          },
          "regression": { "type": ["object", "null"] }
        },
        "additionalProperties": true
      }
    },
    "first_pass": { "type": ["object", "null"] },
    "final": { "type": ["object", "null"] },
    "repair_iterations": { "type": "integer", "minimum": 0, "maximum": 3 },
    "regressions_introduced": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true
}
