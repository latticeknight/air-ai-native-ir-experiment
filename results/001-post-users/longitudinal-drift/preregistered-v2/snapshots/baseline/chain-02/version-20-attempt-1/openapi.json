{
  "openapi": "3.1.0",
  "info": {
    "title": "Benchmark 001 users API",
    "version": "1",
    "description": "The health endpoint is capability-free. User endpoints use only the declared user-storage host capabilities and neither import nor perform outbound network access."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": { "status": { "const": "ok" } },
                  "additionalProperties": false
                },
                "example": { "status": "ok" }
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "operationId": "getUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "OK. The response contains only public user fields; audit records and audit metadata are never returned.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/PublicUser" } }
            }
          },
          "404": {
            "description": "User not found, including users that have been soft-deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "const": "not_found" } },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  { "$ref": "./schemas/update-name.schema.json" }
                ],
                "description": "Only the user's name can be updated. Email is immutable for every actor."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated. Audit records and audit metadata are never returned.",
            "content": {
              "application/json": { "schema": { "type": "null" } }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "enum": ["invalid_json", "invalid_name"] } },
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "const": "not_found" } },
                  "additionalProperties": false
                }
              }
            }
          },
          "409": {
            "description": "Suspended users cannot be modified through this endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "const": "user_suspended" } },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteUser",
        "description": "Administrator-only soft deletion. The user is marked deleted and existing email-audit history is preserved.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "204": { "description": "User soft-deleted. Existing email-audit history is preserved." },
          "403": {
            "description": "Only administrators may delete users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "const": "forbidden" } },
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "const": "not_found" } },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}/status": {
      "patch": {
        "operationId": "updateUserStatus",
        "description": "Administrator-only suspension update. A required non-empty suspension reason is stored internally and never returned. Changing status to active is not supported.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "./schemas/update-status.schema.json" } }
          }
        },
        "responses": {
          "200": {
            "description": "User status updated. Audit records and audit metadata are never returned.",
            "content": {
              "application/json": { "schema": { "type": "null" } }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "enum": ["invalid_json", "invalid_status", "invalid_reason"] } },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "Only administrators may update user status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "const": "forbidden" } },
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "const": "not_found" } },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}/profile": {
      "put": {
        "operationId": "updateUserProfile",
        "description": "Stores the user's timezone in the separate profiles table through the table-scoped profile capability.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "./schemas/update-profile.schema.json" } }
          }
        },
        "responses": {
          "200": {
            "description": "Profile timezone stored.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["timezone"],
                  "properties": { "timezone": { "type": "string", "minLength": 1 } },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "enum": ["invalid_json", "invalid_timezone"] } },
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "const": "not_found" } },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "post": {
        "operationId": "createUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "./schemas/create-user.schema.json" } }
          }
        },
        "responses": {
          "201": {
            "description": "Created. Only the public identifier and verification state are returned; audit records and audit metadata are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "verified"],
                  "properties": {
                    "id": { "type": "integer", "minimum": 1 },
                    "verified": { "type": "boolean" }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PublicUser": { "$ref": "./schemas/public-user.schema.json" }
    }
  }
}
