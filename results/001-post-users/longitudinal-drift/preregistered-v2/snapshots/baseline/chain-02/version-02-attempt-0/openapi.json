{
  "openapi": "3.1.0",
  "info": { "title": "Benchmark 001 users API", "version": "1" },
  "paths": {
    "/users": {
      "post": {
        "operationId": "createUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "./schemas/create-user.schema.json" } }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id"],
                  "properties": { "id": { "type": "integer", "minimum": 1 } },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PublicUser": { "$ref": "./schemas/public-user.schema.json" }
    }
  }
}
