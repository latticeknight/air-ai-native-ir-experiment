{
  "openapi": "3.1.0",
  "info": { "title": "Benchmark 001 users API", "version": "1" },
  "paths": {
    "/users": {
      "post": {
        "operationId": "createUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "./schemas/create-user.schema.json" } }
          }
        },
        "responses": {
          "201": {
            "description": "Created. Audit records and audit metadata are not returned.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "verified"],
                  "properties": {
                    "id": { "type": "integer", "minimum": 1 },
                    "verified": { "type": "boolean" }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "delete": {
        "operationId": "deleteUser",
        "description": "Administrators can soft-delete users. Existing email-audit history is preserved, and deleted users are not returned by user lookup.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "204": { "description": "User soft-deleted. Existing email-audit history is preserved." },
          "403": {
            "description": "Administrator role required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "const": "forbidden" } },
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "const": "not_found" } },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateUser",
        "description": "Users can update their name. Suspended users cannot be modified. Email addresses are immutable for every actor.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "./schemas/update-user.schema.json" } }
          }
        },
        "responses": {
          "200": {
            "description": "User updated. Audit records and audit metadata are not returned.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok"],
                  "properties": { "ok": { "const": true } },
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "const": "not_found" } },
                  "additionalProperties": false
                }
              }
            }
          },
          "409": {
            "description": "Suspended users cannot be modified",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "const": "user_suspended" } },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Public user. Audit records and audit metadata are not returned.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/PublicUser" } }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "const": "not_found" } },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}/status": {
      "patch": {
        "operationId": "updateUserStatus",
        "description": "Administrators can update a user's public status.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "./schemas/update-user-status.schema.json" } }
          }
        },
        "responses": {
          "200": {
            "description": "User status updated. Audit records and audit metadata are not returned.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok"],
                  "properties": { "ok": { "const": true } },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid status payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "enum": ["invalid_json", "invalid_status"] } },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "Administrator role required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "const": "forbidden" } },
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": { "error": { "const": "not_found" } },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PublicUser": { "$ref": "./schemas/public-user.schema.json" }
    }
  }
}
